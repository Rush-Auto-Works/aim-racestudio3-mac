 DWORD WINAPI WlanQueryInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCODE opcode,
                     void *reserved, DWORD *data_size, void **data, WLAN_OPCODE_VALUE_TYPE *opcode_type)
 {
-    FIXME("(%p, %s, 0x%x, %p, %p, %p, %p) stub\n",
+    FIXME("(%p, %s, 0x%x, %p, %p, %p, %p) AiM\n",
           handle, wine_dbgstr_guid(guid), opcode, reserved, data_size, data, opcode_type);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || reserved || !data_size || !data)
+        return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+
+    /* AiM: RS3 spins on current_connection waiting to be "connected". Report a connected
+     * infrastructure association to the dash SSID so it proceeds to aim-ka discovery. */
+    if (opcode == wlan_intf_opcode_current_connection)
+    {
+        AIM_WLAN_CONNECTION_ATTRIBUTES *conn = WlanAllocateMemory(sizeof(*conn));
+        DWORD i;
+        if (!conn) return ERROR_NOT_ENOUGH_MEMORY;
+        memset(conn, 0, sizeof(*conn));
+        conn->isState = wlan_interface_state_connected;
+        conn->wlanConnectionMode = wlan_connection_mode_profile;
+        for (i = 0; i < sizeof(AIM_SSID) && i < ARRAY_SIZE(conn->strProfileName) - 1; i++)
+            conn->strProfileName[i] = (WCHAR)(unsigned char)AIM_SSID[i]; /* ASCII -> WCHAR */
+        conn->wlanAssociationAttributes.dot11Ssid.uSSIDLength = sizeof(AIM_SSID) - 1;
+        memcpy(conn->wlanAssociationAttributes.dot11Ssid.ucSSID, AIM_SSID, sizeof(AIM_SSID) - 1);
+        conn->wlanAssociationAttributes.dot11BssType = 1;   /* infrastructure */
+        conn->wlanAssociationAttributes.dot11PhyType = 7;   /* HT */
+        conn->wlanAssociationAttributes.wlanSignalQuality = 90;
+        conn->wlanAssociationAttributes.ulRxRate = 65000;
+        conn->wlanAssociationAttributes.ulTxRate = 65000;
+        *data = conn;
+        *data_size = sizeof(*conn);
+        if (opcode_type) *opcode_type = wlan_opcode_value_type_query_only;
+        AIM_DIAG_ONCE(("AiM/wlanapi: WlanQueryInterface(current_connection) -> connected (RS3 proceeding to dash discovery)\n"));
+        return ERROR_SUCCESS;
+    }
+    if (opcode == wlan_intf_opcode_interface_state)
+    {
+        WLAN_INTERFACE_STATE *st = WlanAllocateMemory(sizeof(*st));
+        if (!st) return ERROR_NOT_ENOUGH_MEMORY;
+        *st = wlan_interface_state_connected;
+        *data = st;
+        *data_size = sizeof(*st);
+        if (opcode_type) *opcode_type = wlan_opcode_value_type_query_only;
+        return ERROR_SUCCESS;
+    }
+
+    return ERROR_NOT_SUPPORTED;
 }
 
+/* AiM: RS3 3.83.39 rewrote its Wi-Fi manager. Right after WlanQueryInterface reports the
+ * synthetic interface "connected", the new code calls WlanSetInterface — and can reach other
+ * exports the old menu never touched. Wine 11.9 marks all of those `@ stub`, and calling a stub
+ * raises EXCEPTION_WINE_STUB into the calling RS3 thread ("wine: Call from … to unimplemented
+ * function wlanapi.dll.WlanSetInterface, aborting" in run.log on EVERY launch, 3.83.50 verified
+ * 2026-09-05). RS3 swallows the exception, but its Wi-Fi thread unwinds mid-operation, which is
+ * the classic way to leave a lock held and freeze the UI minutes later.
+ *
+ * So: accept WlanSetInterface on the synthetic interface (there is nothing to set — the
+ * association is fake and always "connected"), and give every remaining export a real entry
+ * point that returns ERROR_NOT_SUPPORTED instead of raising. None of this touches macOS Wi-Fi;
+ * that is the point. (WlanSetProfileEapUserData / WlanSetProfileEapXmlUserData stay stubs: they
+ * take EAP_METHOD_TYPE by value, which the .spec cannot express; RS3 does no EAP.) */
+DWORD WINAPI WlanSetInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCODE opcode,
+                              DWORD data_size, const void *data, void *reserved)
+{
+    FIXME("(%p, %s, 0x%x, %lu, %p, %p) AiM: accepted on the synthetic interface\n",
+          handle, wine_dbgstr_guid(guid), opcode, data_size, data, reserved);
+
+    if (!handle || !guid || reserved || (data_size && !data))
+        return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+
+    AIM_DIAG_ONCE(("AiM/wlanapi: WlanSetInterface(opcode 0x%x, %lu bytes) -> accepted (was a Wine stub exception in RS3's Wi-Fi thread)\n",
+                   opcode, data_size));
+    return ERROR_SUCCESS;
+}
+
+/* AiM: a non-raising "not supported" body for the exports Wine 11.9 leaves as `@ stub`. */
+#define AIM_NOT_SUPPORTED(name, ...) \
+    DWORD WINAPI name(__VA_ARGS__) \
+    { \
+        FIXME("AiM: " #name " -> ERROR_NOT_SUPPORTED (synthetic interface)\n"); \
+        AIM_DIAG_ONCE(("AiM/wlanapi: " #name " -> ERROR_NOT_SUPPORTED (no stub exception; RS3's Wi-Fi rewrite reached a call the synthetic interface cannot serve)\n")); \
+        return ERROR_NOT_SUPPORTED; \
+    }
+
+AIM_NOT_SUPPORTED(WlanConnect, HANDLE handle, const GUID *guid, const void *params, void *reserved)
+AIM_NOT_SUPPORTED(WlanDisconnect, HANDLE handle, const GUID *guid, void *reserved)
+AIM_NOT_SUPPORTED(WlanDeleteProfile, HANDLE handle, const GUID *guid, const WCHAR *name, void *reserved)
+AIM_NOT_SUPPORTED(WlanExtractPsdIEDataList, HANDLE handle, DWORD ie_size, const BYTE *ie, const WCHAR *format, void *reserved, void **list)
+AIM_NOT_SUPPORTED(WlanGetFilterList, HANDLE handle, DWORD type, void *reserved, void **list)
+AIM_NOT_SUPPORTED(WlanGetInterfaceCapability, HANDLE handle, const GUID *guid, void *reserved, void **capability)
+AIM_NOT_SUPPORTED(WlanGetNetworkBssList, HANDLE handle, const GUID *guid, const DOT11_SSID *ssid, DOT11_BSS_TYPE type, BOOL secure, void *reserved, void **list)
+AIM_NOT_SUPPORTED(WlanGetProfile, HANDLE handle, const GUID *guid, const WCHAR *name, void *reserved, WCHAR **xml, DWORD *flags, DWORD *access)
+AIM_NOT_SUPPORTED(WlanGetProfileCustomUserData, HANDLE handle, const GUID *guid, const WCHAR *name, void *reserved, DWORD *size, BYTE **data)
+AIM_NOT_SUPPORTED(WlanGetProfileList, HANDLE handle, const GUID *guid, void *reserved, void **list)
+AIM_NOT_SUPPORTED(WlanGetSecuritySettings, HANDLE handle, DWORD object, WLAN_OPCODE_VALUE_TYPE *type, WCHAR **sddl, DWORD *access)
+AIM_NOT_SUPPORTED(WlanIhvControl, HANDLE handle, const GUID *guid, DWORD type, DWORD in_size, void *in, DWORD out_size, void *out, DWORD *out_ret)
+AIM_NOT_SUPPORTED(WlanQueryAutoConfigParameter, HANDLE handle, DWORD opcode, void *reserved, DWORD *size, void **data, WLAN_OPCODE_VALUE_TYPE *type)
+AIM_NOT_SUPPORTED(WlanReasonCodeToString, WLAN_REASON_CODE code, DWORD size, WCHAR *str, void *reserved)
+AIM_NOT_SUPPORTED(WlanRenameProfile, HANDLE handle, const GUID *guid, const WCHAR *old_name, const WCHAR *new_name, void *reserved)
+AIM_NOT_SUPPORTED(WlanSaveTemporaryProfile, HANDLE handle, const GUID *guid, const WCHAR *name, const WCHAR *all_user, DWORD flags, BOOL overwrite, void *reserved)
+AIM_NOT_SUPPORTED(WlanSetAutoConfigParameter, HANDLE handle, DWORD opcode, DWORD size, const void *data, void *reserved)
+AIM_NOT_SUPPORTED(WlanSetFilterList, HANDLE handle, DWORD type, const void *list, void *reserved)
+AIM_NOT_SUPPORTED(WlanSetProfile, HANDLE handle, const GUID *guid, DWORD flags, const WCHAR *xml, const WCHAR *all_user, BOOL overwrite, void *reserved, DWORD *reason)
+AIM_NOT_SUPPORTED(WlanSetProfileCustomUserData, HANDLE handle, const GUID *guid, const WCHAR *name, DWORD size, const BYTE *data, void *reserved)
